# ===== Уютный Квадрат — переменные окружения =====
# Скопируйте в .env для локального запуска. На Railway задайте их в разделе Variables.

# Порт (Railway задаёт автоматически; локально по умолчанию 3000)
PORT=3000

# Вход в панель менеджера (обязательно задайте свои значения!)
ADMIN_USERNAME=manager
ADMIN_PASSWORD=change-me-please

# Секрет для подписи сессионных cookie (длинная случайная строка).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Ставьте true, если сайт открывается по HTTPS (на Railway — true).
COOKIE_SECURE=false

# Путь к файлу базы данных. На Railway примонтируйте Volume и укажите путь внутри него.
DATABASE_PATH=./data/bookings.db

# Уведомления о новых бронях в Telegram (необязательно).
# Токен от @BotFather, chat_id — от @getmyid_bot. Токен НЕ попадает в браузер.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Секрет для Telegram-webhook (кнопки «Подтвердить/Заселить/Отменить» в чате).
# Придумайте случайную строку и укажите её же при регистрации webhook (setWebhook).
TELEGRAM_WEBHOOK_SECRET=

# Название бренда в уведомлениях
BRAND_NAME=Уютный Квадрат
